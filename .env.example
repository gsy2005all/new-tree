# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
VERSION=0.1.0

# ===== 安全（必填！生产环境务必改成一段足够长的随机字符串）=====
JWT_SECRET="abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde"
# token 有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080

# ===== 数据库 =====
DB_FILE=database.db

# ===== 上传 =====
# 图片保存目录（相对于项目根）
UPLOAD_DIR=static/uploads
# 单文件最大字节数（默认 5MB）
UPLOAD_MAX_BYTES=5242880

# ===== 缓存 =====
CACHE_TTL=60
CACHE_MAXSIZE=512

# ===== 限流（敏感接口窗口内最大次数）=====
RATELIMIT_WINDOW=60
RATELIMIT_MAX=10

# ===== CORS =====
# 多个源用逗号分隔，例如 http://localhost:3000,https://app.example.com
CORS_ORIGINS=*

# ===== 日志 =====
LOG_FORMAT="{time:YYYY-MM-DD at HH:mm:ss} | {level} | {message}"
